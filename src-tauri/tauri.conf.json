{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plainleaf",
  "version": "0.1.0",
  "identifier": "com.techsnazzy.plainleaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plainleaf",
        "width": 960,
        "height": 820,
        "minWidth": 520,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'none'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A quiet Markdown reader and editor",
    "category": "Productivity",
    "linux": {
      "deb": { "desktopTemplate": "linux/plainleaf.desktop" },
      "rpm": { "desktopTemplate": "linux/plainleaf.desktop" }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  }
}
